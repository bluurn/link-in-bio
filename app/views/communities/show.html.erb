<% content_for :title, @community.name %>
<div class="flex min-h-screen flex-col bg-gray-50">

  <%# Hero banner — DiceBear as background %>
  <div class="relative h-16 overflow-hidden bg-indigo-100">
    <img src="https://api.dicebear.com/9.x/shapes/svg?seed=<%= @community.slug %>-banner&size=600&backgroundColor=6366f1,8b5cf6,ec4899"
         alt=""
         class="h-full w-full object-cover">
    <%# Dark gradient for text legibility %>
    <div class="absolute inset-0 bg-gradient-to-t from-black/60 to-transparent"></div>
    <%# Title centered in banner %>
    <div class="absolute inset-0 flex items-center px-5">
      <h1 class="text-xl font-bold text-white drop-shadow"><%= @community.name %></h1>
    </div>
  </div>

  <div class="mx-auto flex w-full max-w-5xl grow flex-col px-4 pt-5">
    <%# Selected content cards %>
    <% if @selections.empty? %>
      <%= render "shared/empty_state", message: "No links yet." %>
    <% else %>
      <div class="grid grid-cols-1 gap-4 pb-10 sm:grid-cols-2 lg:grid-cols-3">
        <% @selections.each do |selection| %>
          <%= render "contents/content_card", content: selection.content, community: @community %>
        <% end %>
      </div>
    <% end %>

    <p class="mt-auto pb-6 pt-4 text-center text-xs text-gray-400">Powered by Bryght</p>
  </div>
</div>
