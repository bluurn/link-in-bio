<% content_for :title, "#{@content.title} · #{@community.name}" %>
<%
  kind_colors = { "course" => "bg-blue-100 text-blue-700", "event" => "bg-emerald-100 text-emerald-700", "playlist" => "bg-purple-100 text-purple-700" }
  color = kind_colors[@content.kind] || "bg-gray-100 text-gray-700"
%>
<div class="min-h-screen bg-white">
  <%# Cover image %>
  <div class="h-52 w-full bg-gray-100 sm:h-64">
    <% if @content.cover_image_url.present? %>
      <img src="<%= @content.cover_image_url %>" alt="" class="h-full w-full object-cover">
    <% else %>
      <div class="flex h-full w-full items-center justify-center text-5xl">
        <% icons = { "course" => "📚", "event" => "📅", "playlist" => "🎵" } %>
        <%= icons[@content.kind] || "📄" %>
      </div>
    <% end %>
  </div>

  <div class="mx-auto max-w-lg px-4 py-6">
    <%# Back link %>
    <%= link_to community_path(@community.slug), class: "mb-6 inline-flex items-center gap-1 text-sm text-indigo-600 hover:text-indigo-800" do %>
      ← <%= @community.name %>
    <% end %>

    <%# Kind badge %>
    <div class="mt-4">
      <span class="inline-flex rounded-full px-3 py-1 text-sm font-medium <%= color %>">
        <%= @content.kind.capitalize %>
      </span>
    </div>

    <%# Title & creator %>
    <h1 class="mt-3 text-2xl font-bold text-gray-900 leading-tight"><%= @content.title %></h1>
    <p class="mt-1 text-gray-500">by <%= @content.creator %></p>

    <%# Price %>
    <p class="mt-4 text-xl font-semibold text-gray-900">
      <%= @content.price.zero? ? "Free" : number_to_currency(@content.price) %>
    </p>

    <%# Description %>
    <% if @content.description.present? %>
      <p class="mt-4 text-gray-700 leading-relaxed"><%= @content.description %></p>
    <% end %>

    <%# CTA %>
    <%= link_to safe_external_url(@content.url), target: "_blank", rel: "noopener noreferrer",
          class: "mt-8 block w-full rounded-2xl bg-indigo-600 py-4 text-center text-base font-semibold text-white shadow hover:bg-indigo-700 active:scale-[0.98] transition" do %>
      Visit →
    <% end %>
  </div>
</div>
