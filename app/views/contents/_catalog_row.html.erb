<%
  kind_colors = { "course" => "bg-blue-100 text-blue-700", "event" => "bg-emerald-100 text-emerald-700", "playlist" => "bg-purple-100 text-purple-700" }
  color = kind_colors[content.kind] || "bg-gray-100 text-gray-700"
  already_selected = selected_ids.include?(content.id)
%>
<div class="flex items-center gap-3 rounded-xl bg-white p-3 shadow-sm ring-1 ring-gray-100">
  <div class="h-10 w-10 shrink-0 overflow-hidden rounded-lg bg-gray-100">
    <% if content.cover_image_url.present? %>
      <img src="<%= content.cover_image_url %>" alt="" class="h-full w-full object-cover">
    <% else %>
      <div class="flex h-full w-full items-center justify-center text-lg">
        <% icons = { "course" => "📚", "event" => "📅", "playlist" => "🎵" } %>
        <%= icons[content.kind] || "📄" %>
      </div>
    <% end %>
  </div>

  <div class="min-w-0 flex-1">
    <div class="flex items-center gap-1.5">
      <span class="inline-flex rounded-full px-1.5 py-0.5 text-xs font-medium <%= color %>">
        <%= content.kind.capitalize %>
      </span>
    </div>
    <p class="truncate text-sm font-semibold text-gray-900"><%= content.title %></p>
    <p class="truncate text-xs text-gray-500"><%= content.creator %> · <%= content.price.zero? ? "Free" : number_to_currency(content.price) %></p>
  </div>

  <div class="shrink-0">
    <% if already_selected %>
      <span class="inline-flex items-center gap-1 rounded-lg bg-emerald-50 px-3 py-1.5 text-xs font-medium text-emerald-700">
        ✓ Added
      </span>
    <% else %>
      <%= button_to "+ Add",
            selections_path(community.slug),
            method: :post,
            params: { content_id: content.id, q: q, kind: kind },
            class: "rounded-lg bg-indigo-600 px-3 py-1.5 text-xs font-semibold text-white hover:bg-indigo-700 transition" %>
    <% end %>
  </div>
</div>
