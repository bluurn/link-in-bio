<%
  kind_colors = { "course" => "bg-blue-100 text-blue-700", "event" => "bg-emerald-100 text-emerald-700", "playlist" => "bg-purple-100 text-purple-700" }
  color = kind_colors[selection.content.kind] || "bg-gray-100 text-gray-700"
%>
<div class="flex items-center gap-3 rounded-xl bg-white p-3 shadow-sm ring-1 ring-gray-100">
  <div class="h-10 w-10 shrink-0 overflow-hidden rounded-lg bg-gray-100">
    <% if selection.content.cover_image_url.present? %>
      <img src="<%= selection.content.cover_image_url %>" alt="" class="h-full w-full object-cover">
    <% else %>
      <div class="flex h-full w-full items-center justify-center text-lg">
        <% icons = { "course" => "📚", "event" => "📅", "playlist" => "🎵" } %>
        <%= icons[selection.content.kind] || "📄" %>
      </div>
    <% end %>
  </div>

  <div class="min-w-0 flex-1">
    <span class="inline-flex rounded-full px-1.5 py-0.5 text-xs font-medium <%= color %>">
      <%= selection.content.kind.capitalize %>
    </span>
    <p class="truncate text-sm font-semibold text-gray-900"><%= selection.content.title %></p>
    <p class="truncate text-xs text-gray-500"><%= selection.content.price.zero? ? "Free" : number_to_currency(selection.content.price) %></p>
  </div>

  <div class="shrink-0">
    <%= button_to "Remove",
          selection_path(community.slug, selection.id),
          method: :delete,
          params: { q: q, kind: kind },
          class: "rounded-lg bg-red-50 px-3 py-1.5 text-xs font-semibold text-red-600 hover:bg-red-100 transition" %>
  </div>
</div>
