<%
  kind_colors = { "course" => "bg-blue-100 text-blue-700", "event" => "bg-emerald-100 text-emerald-700", "playlist" => "bg-purple-100 text-purple-700" }
  kind_bg     = { "course" => "from-blue-400 to-blue-600", "event" => "from-emerald-400 to-emerald-600", "playlist" => "from-purple-400 to-purple-600" }
  color    = kind_colors[selection.content.kind] || "bg-gray-100 text-gray-700"
  gradient = kind_bg[selection.content.kind]     || "from-gray-400 to-gray-600"
%>
<div class="flex items-center gap-3 rounded-xl bg-white p-3 shadow-sm ring-1 ring-gray-100">
  <div class="h-12 w-12 shrink-0 overflow-hidden rounded-lg bg-gray-100">
    <% if selection.content.cover_image_url.present? %>
      <img src="<%= selection.content.cover_image_url %>" alt="" class="h-full w-full object-cover">
    <% else %>
      <div class="h-full w-full bg-gradient-to-br <%= gradient %>"></div>
    <% end %>
  </div>

  <div class="min-w-0 flex-1">
    <div class="flex items-center gap-1.5">
      <span class="inline-flex rounded-full px-2 py-0.5 text-xs font-semibold <%= color %>">
        <%= selection.content.kind.capitalize %>
      </span>
    </div>
    <p class="text-sm font-semibold text-gray-900"><%= selection.content.title %></p>
    <p class="truncate text-xs text-gray-500"><%= selection.content.creator %></p>
  </div>

  <div class="shrink-0">
    <%= button_to "Remove",
          selection_path(community.slug, selection.id),
          method: :delete,
          params: { q: q, kind: kind },
          data: { turbo_frame: "_top" },
          class: "rounded-lg bg-red-50 px-3 py-1.5 text-xs font-semibold text-red-600 hover:bg-red-100 transition" %>
  </div>
</div>
