<% content_for :title, "Manage · #{@community.name}" %>
<div class="min-h-screen bg-gray-50">
  <%# Header %>
  <div class="bg-white shadow-sm">
    <div class="mx-auto max-w-5xl px-4 py-4">
      <div class="flex items-center justify-between">
        <div>
          <p class="text-xs font-medium text-indigo-600 uppercase tracking-wide">Managing</p>
          <h1 class="text-xl font-bold text-gray-900"><%= @community.name %></h1>
        </div>
        <%= link_to "View page →", community_path(@community.slug),
              class: "text-sm text-indigo-600 hover:text-indigo-800 font-medium" %>
      </div>
    </div>
  </div>

  <div class="mx-auto max-w-5xl px-4 py-6">
    <div class="grid grid-cols-1 gap-6 lg:grid-cols-2">

      <%# LEFT: Catalog %>
      <div>
        <h2 class="mb-3 text-base font-semibold text-gray-700">Catalog</h2>

        <%# Search & filter form — targets the catalog Turbo Frame %>
        <%= form_with url: manage_path(@community.slug), method: :get,
              data: { turbo_frame: "catalog", controller: "search" } do |f| %>
          <%# Type filter chips %>
          <div class="mb-3 flex flex-wrap gap-2">
            <% [["All", ""], ["Course", "course"], ["Event", "event"], ["Playlist", "playlist"]].each do |label, val| %>
              <%= link_to label, manage_path(@community.slug, kind: val, q: @q),
                    data: { turbo_frame: "catalog" },
                    class: [
                      "rounded-full px-3 py-1 text-sm font-medium transition",
                      @kind == val ? "bg-indigo-600 text-white" : "bg-white text-gray-600 ring-1 ring-gray-200 hover:bg-gray-50"
                    ].join(" ") %>
            <% end %>
          </div>

          <%# Search input %>
          <%= f.hidden_field :kind, value: @kind %>
          <%= f.text_field :q, value: @q,
                placeholder: "Search by title…",
                autocomplete: "off",
                data: { action: "input->search#debounce" },
                class: "w-full rounded-xl border-0 bg-white px-4 py-3 text-sm shadow-sm ring-1 ring-gray-200 placeholder-gray-400 focus:ring-2 focus:ring-indigo-500 focus:outline-none" %>
        <% end %>

        <%# Catalog results in Turbo Frame %>
        <turbo-frame id="catalog" class="mt-3 block">
          <% if @catalog.empty? %>
            <%= render "shared/empty_state", message: @q.present? ? "No results for &ldquo;#{@q}&rdquo;." : "No contents found." %>
          <% else %>
            <div class="space-y-2">
              <% @catalog.each do |content| %>
                <%= render "contents/catalog_row",
                      content: content,
                      community: @community,
                      selected_ids: @selected_ids,
                      q: @q,
                      kind: @kind %>
              <% end %>
            </div>
          <% end %>
        </turbo-frame>
      </div>

      <%# RIGHT: Current selection %>
      <div>
        <h2 class="mb-3 text-base font-semibold text-gray-700">
          Current selection
          <span class="ml-1 rounded-full bg-indigo-100 px-2 py-0.5 text-xs font-semibold text-indigo-700">
            <%= @selections.size %>
          </span>
        </h2>

        <% if @selections.empty? %>
          <%= render "shared/empty_state", message: "Nothing selected yet. Add items from the catalog." %>
        <% else %>
          <div class="space-y-2">
            <% @selections.each do |selection| %>
              <%= render "selections/selection_item",
                    selection: selection,
                    community: @community,
                    q: @q,
                    kind: @kind %>
            <% end %>
          </div>
        <% end %>
      </div>

    </div>
  </div>
</div>
